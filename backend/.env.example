# Broker Configuration
# BROKER_ID is auto-generated from hostname if not set (recommended for dynamic scaling)
# BROKER_ID=broker-1
BROKER_PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=pubsub_user
DB_PASSWORD=pubsub_password
DB_NAME=music_pubsub

# Cluster Configuration - Dynamic Discovery
# Set IS_SEED=true for the first/seed broker
IS_SEED=false
# Point non-seed brokers to the seed broker for auto-discovery
SEED_BROKER=seed-broker:5000

# Broker-to-Broker Authentication
# All brokers in the cluster must share the same secret
BROKER_SECRET=change_me_in_production

# Legacy: manually specify peers (optional, overrides dynamic discovery)
# PEER_BROKERS=broker-2:5000,broker-3:5000

# Service Configuration
HEARTBEAT_INTERVAL=5000
GOSSIP_INTERVAL=2000
FANOUT=2

# Logging
LOG_LEVEL=info